# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# 구글 서비스 계정 키 (Sheets API) — 절대 커밋 금지
google-service-account.json

# vercel
.vercel

# 읽은 논문 PDF 로컬 보관용 — 저작권·용량 문제로 커밋 금지
/downloads

# 실제 아카이브 데이터 — 로컬/Supabase에만 두고 저장소엔 코드 구조만 남긴다
/data/*.csv
/data/raw/

# 개인 기획/조사 메모 — 코드 저장소엔 프로젝트 설명(README)만 남기고 로컬 전용으로 전환
/docs/plan.md
/docs/roadmap.md
/docs/literature_review.md
/docs/pilot1.md

# 디자인 참고 이미지 — 용량·출처 문제로 로컬 전용
/reference

# 내려받은 에이전트 스킬 본문 — skills-lock.json의 출처/해시로 다시 받을 수 있으므로 커밋하지 않는다
/.agents

# typescript
*.tsbuildinfo
next-env.d.ts
